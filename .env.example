# Copy to apps/api/.env, apps/worker/.env, and apps/web/.env.local /
# apps/portal/.env.local as appropriate — see each app's README for which
# variables it reads. Values below match docker-compose.yml's local dev
# services; never commit real secrets.

NODE_ENV=development

# --- apps/api ---
PORT=3001
# The migration/owner role — used only by `prisma migrate deploy`/
# `prisma db seed`/`prisma generate`. See APP_DATABASE_URL below for the
# role the running app actually connects as.
#
# Port 5433, not 5432: `docker-compose.yml` deliberately publishes Postgres
# on 5433 so it cannot collide with a native Postgres already owning 5432
# (see that file's own comment on the `postgres` service). Pointing this at
# 5432 silently targets whatever *other* Postgres is on that port — which
# fails authentication rather than erroring usefully — so keep these two
# files in agreement.
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5433/crm?schema=public"
REDIS_URL="redis://localhost:6379"

# Story 115 — the restricted runtime role (`crm_app`) both `apps/api` and
# `apps/worker` actually connect as; provisioned by the
# `add_runtime_db_role_grants` migration, which also denies it UPDATE/
# DELETE on `admin.audit_logs` and any schema-altering privilege (see
# docs/architecture/05-auth-and-security.md). Optional — omitting it
# falls back to DATABASE_URL (the owner role) unchanged, for any
# environment that hasn't opted in yet. The password below is a fixed,
# non-secret, dev/CI-only value, exactly like DATABASE_URL's own
# `crm_dev_password` above — a real production deployment must rotate it
# (`ALTER ROLE crm_app WITH PASSWORD ...`) before going live.
APP_DATABASE_URL="postgresql://crm_app:crm_app_dev_password@localhost:5433/crm?schema=public"

# Generate real values with, e.g., `openssl rand -base64 48` — must be
# at least 32 characters. Never reuse the placeholders below outside local dev.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-please-32chars-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-please-32chars-min"
JWT_REFRESH_TTL_DAYS=7

S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="crm-attachments"

# Story 23 — comma-separated allowed browser origins for the REST API and
# the Socket.IO gateway (both apps' CORS and their socket handshakes).
# Unset by default: no origin is allowed until a deployment opts in. Never
# put a production hostname here — production origins are supplied through
# deployment environment configuration, not this file.
#
# BOTH local frontends must be listed: `apps/web` runs on 3000 and
# `apps/portal` on 3002 (`next dev -p 3002`, see its package.json). Omitting
# 3002 leaves the Customer Portal unable to call the API or open a socket
# at all — every request fails the browser's CORS preflight, with the API
# itself logging nothing.
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# Read only by `prisma/seed.ts` (via `pnpm --filter @crm/api prisma:seed`),
# never by the running app — see Story 03. Change the password before
# using this anywhere other than local dev.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-locally-32chars-minplus"

# Story 113 — optional. Unset by default: unhandled exceptions are still
# caught and logged either way, just not reported anywhere external.
# Sentry or self-hosted GlitchTip both work unchanged (GlitchTip is
# Sentry-protocol-compatible) — just point this at whichever DSN.
SENTRY_DSN=""

# --- apps/worker ---
# (reuses DATABASE_URL, APP_DATABASE_URL, REDIS_URL, NODE_ENV, and
# SENTRY_DSN above)

# --- apps/web / apps/portal ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# Story 113 — same as apps/api's own SENTRY_DSN above, but `NEXT_PUBLIC_`-
# prefixed: only `NEXT_PUBLIC_*` env vars are inlined into the browser
# bundle at build time (a plain SENTRY_DSN reads as undefined in client
# code). Set both to the same value; `apps/web`/`apps/portal`'s
# server/edge runtimes still read the plain `SENTRY_DSN` above.
NEXT_PUBLIC_SENTRY_DSN=""
