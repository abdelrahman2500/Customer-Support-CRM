{
  "name": "@crm/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Customer Support CRM — background job worker (NestJS standalone, BullMQ).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --exclude \"**/*.e2e-spec.ts\"",
    "test:e2e": "vitest run e2e-spec"
  },
  "dependencies": {
    "@crm/ai": "workspace:*",
    "@crm/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@prisma/client": "6.19.3",
    "bullmq": "^6.2.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@crm/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
