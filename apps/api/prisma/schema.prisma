// Customer Support CRM — Prisma schema
//
// Source of truth: docs/architecture/04-data-and-multitenancy.md
// This is the MINIMAL foundation schema for Story 02 (identity/auth/tenant
// only). Feature-domain tables (customers, ticketing, SLA, KB, AI, channels,
// notifications, reporting, integrations) are added by their own future
// stories, each in its own logical Postgres schema per
// docs/architecture/03-domain-boundaries.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), pg_trgm]
  schemas    = ["identity", "admin", "customers", "ticketing", "sla", "notifications", "knowledge_base", "ai", "channels"]
}

// ---------------------------------------------------------------------------
// identity schema
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  branches  Branch[]

  @@map("organizations")
  @@schema("identity")
}

model Branch {
  id                    String                 @id @default(uuid())
  organizationId        String                 @map("organization_id")
  organization          Organization           @relation(fields: [organizationId], references: [id])
  name                  String
  timezone              String
  isActive              Boolean                @default(true) @map("is_active")
  departments           Department[]
  userRoles             UserBranchRole[]
  customers             Customer[]
  tickets               Ticket[]
  slaPolicies           SlaPolicy[]
  businessHoursCalendar BusinessHoursCalendar?
  knowledgeBaseArticles KnowledgeBaseArticle[]
  automationRules       AutomationRule[]
  notificationTemplates NotificationTemplate[]
  brandingConfig        BrandingConfig?
  aiPromptLogs          AiPromptLog[]
  chatSessions          ChatSession[]
  aiSettings            AiSettings?
  quickReplies          QuickReply[]
  createdAt             DateTime               @default(now()) @map("created_at")

  @@unique([organizationId, name])
  @@map("branches")
  @@schema("identity")
}

model Department {
  id              String           @id @default(uuid())
  branchId        String           @map("branch_id")
  branch          Branch           @relation(fields: [branchId], references: [id])
  name            String
  isActive        Boolean          @default(true) @map("is_active")
  userRoles       UserBranchRole[]
  tickets         Ticket[]
  slaPolicies     SlaPolicy[]
  automationRules AutomationRule[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([branchId, name])
  @@map("departments")
  @@schema("identity")
}

model User {
  id                          String                   @id @default(uuid())
  email                       String                   @unique
  passwordHash                String                   @map("password_hash")
  fullName                    String                   @map("full_name")
  isActive                    Boolean                  @default(true) @map("is_active")
  branchRoles                 UserBranchRole[]
  refreshTokens               RefreshToken[]
  assignedTickets             Ticket[]
  ticketHistoryEntries        TicketHistoryEntry[]
  ticketNotes                 TicketNote[]
  automationRules             AutomationRule[]
  notificationPreferences     NotificationPreference[]
  uploadedAttachments         TicketAttachment[]
  uploadedCustomerAttachments CustomerAttachment[]
  channelMessages             ChannelMessage[]
  /// Story 92 — this agent's own "read up to" cursor over `NotificationLog`
  /// (a per-recipient timestamp, not a column on `NotificationLog` itself,
  /// since those rows are shared by every agent in a branch — see
  /// `NotificationsService.getUnreadCount`'s own doc comment). `null` means
  /// "never marked read" — every matching row counts as unread.
  notificationsReadAt         DateTime?                @map("notifications_read_at")
  createdAt                   DateTime                 @default(now()) @map("created_at")
  updatedAt                   DateTime                 @updatedAt @map("updated_at")

  @@map("users")
  @@schema("identity")
}

/// Story 68 — `BRANCH` (default) reproduces every pre-Story-68 role's
/// exact ticket-visibility behavior; `DEPARTMENT` restricts
/// `TicketsService`'s ticket list/get to the caller's own department plus
/// unassigned (`departmentId: null`) tickets. See
/// docs/architecture/05-auth-and-security.md ("department visibility").
enum TicketVisibilityScope {
  BRANCH
  DEPARTMENT

  @@schema("identity")
}

model Role {
  id                    String                @id @default(uuid())
  name                  String                @unique
  isActive              Boolean               @default(true) @map("is_active")
  ticketVisibilityScope TicketVisibilityScope @default(BRANCH) @map("ticket_visibility_scope")
  permissions           RolePermission[]
  userRoles             UserBranchRole[]
  createdAt             DateTime              @default(now()) @map("created_at")

  @@map("roles")
  @@schema("identity")
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique // e.g. "ticket:reassign"
  roles RolePermission[]

  @@map("permissions")
  @@schema("identity")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

/// A user can hold a role scoped to a branch (and optionally a department
/// within it). This is the enforcement point for the multi-branch /
/// multi-department model — see docs/architecture/04-data-and-multitenancy.md.
model UserBranchRole {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId     String      @map("branch_id")
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleId       String      @map("role_id")
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@unique([userId, branchId, departmentId, roleId])
  @@map("user_branch_roles")
  @@schema("identity")
}

/// Rotating refresh-token record — see docs/architecture/05-auth-and-security.md
/// ("rotating refresh token"). Only the SHA-256 hash of the token is stored,
/// never the raw token, so a leaked database dump cannot be replayed.
/// A row is consumed (rotated) on every successful refresh: `revokedAt` is
/// set on the old row and a new row is inserted for the next token.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// admin schema
// ---------------------------------------------------------------------------

/// Append-only audit log. The application's runtime DB role must be granted
/// INSERT/SELECT only on this table (no UPDATE/DELETE) — see
/// docs/architecture/05-auth-and-security.md. Enforcing that grant is a
/// deployment/DBA task tracked as a follow-up (see Story 02 plan's Done
/// Criteria); Prisma itself cannot express column/row privileges.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  branchId   String?  @map("branch_id")
  diff       Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  /// Story 104 — supports the branch-scoped, `createdAt`-ordered,
  /// capped query `AuditLogsService.listAuditLogs` now always runs.
  @@index([branchId, createdAt])
  @@map("audit_logs")
  @@schema("admin")
}

/// Story 62 — a branch's optional visual identity (logo URL, two brand
/// colors). One row per branch (`branchId` `@unique`) — an unconfigured
/// branch has no row at all, not a row of nulls; `GET /branding` defaults to
/// nulls rather than 404ing (mirrors `NotificationPreference`'s own
/// "absence means default" convention). Config + admin-form preview only
/// for now — not yet consumed by either frontend app's shared layout (see
/// the plan's Design decisions for why).
model BrandingConfig {
  id             String   @id @default(uuid())
  branchId       String   @unique @map("branch_id")
  branch         Branch   @relation(fields: [branchId], references: [id])
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("branding_configs")
  @@schema("admin")
}

// ---------------------------------------------------------------------------
// customers schema
// ---------------------------------------------------------------------------

/// Aggregate root for the Customer Management domain — see
/// docs/architecture/03-domain-boundaries.md ("Customer Management").
/// Branch-scoped per docs/architecture/04-data-and-multitenancy.md; no
/// departmentId — departments route tickets, not customer identity, and no
/// story has justified department-scoping a customer yet.
model Customer {
  id               String               @id @default(uuid())
  branchId         String               @map("branch_id")
  branch           Branch               @relation(fields: [branchId], references: [id])
  displayName      String               @map("display_name")
  isActive         Boolean              @default(true) @map("is_active")
  contacts         Contact[]
  tickets          Ticket[]
  attachments      CustomerAttachment[]
  /// Story 88 — the portal-scoped half of `NotificationLog`; see that
  /// model's own `customerId` doc comment.
  notificationLogs NotificationLog[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("customers")
  @@schema("customers")
}

/// A person belonging to exactly one Customer — no independent lifecycle or
/// permission namespace (mutations reuse `customer:*`, see identity.service.ts
/// precedent for a sub-entity of an aggregate root, e.g. UserBranchRole).
/// Email is unique per Customer, never globally — the same real person's
/// email may legitimately appear under a different Customer.
model Contact {
  id                      String                         @id @default(uuid())
  customerId              String                         @map("customer_id")
  customer                Customer                       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName                String                         @map("full_name")
  email                   String?
  phone                   String?
  isPrimary               Boolean                        @default(false) @map("is_primary")
  /// Story 52 — nullable: a Contact has no portal access until an agent
  /// explicitly sets one (`CustomersService.setContactPortalPassword`, no
  /// self-registration — see docs/architecture/05-auth-and-security.md).
  /// `email` is unique only per-Customer (this model's own doc comment
  /// above), so login-lookup safety for portal-enabled contacts is enforced
  /// at the application layer, not by a DB constraint — see
  /// `setContactPortalPassword`'s own doc comment.
  passwordHash            String?                        @map("password_hash")
  tickets                 Ticket[]
  refreshTokens           ContactRefreshToken[]
  csatResponses           TicketCsatResponse[]
  channelMessages         ChannelMessage[]
  chatSessions            ChatSession[]
  /// Story 103 — this Contact's own uploaded ticket attachments.
  ticketAttachments       TicketAttachment[]
  /// Story 90 — this Contact's own `PortalNotificationPreference` rows.
  notificationPreferences PortalNotificationPreference[]
  /// Story 92 — this Contact's own "read up to" cursor over
  /// `NotificationLog`. Lives on `Contact`, not `Customer`: `Contact.id` is
  /// the portal JWT's `sub` (the actual per-login identity —
  /// `CustomersService.setContactPortalPassword` is already per-Contact),
  /// even though `NotificationLog` rows themselves are `customerId`-scoped
  /// and shared by every Contact of that Customer — see
  /// `NotificationsService.getUnreadCountForCustomer`'s own doc comment.
  /// `null` means "never marked read".
  notificationsReadAt     DateTime?                      @map("notifications_read_at")
  createdAt               DateTime                       @default(now()) @map("created_at")

  @@unique([customerId, email])
  @@index([customerId])
  @@map("contacts")
  @@schema("customers")
}

/// Story 52 — mirrors `identity.RefreshToken` exactly, but scoped to a
/// `Contact` rather than a `User`: a separate table (not a widened
/// `identity.refresh_tokens`) so the `customers` schema keeps owning
/// everything about a Contact's lifecycle, and so the already-battle-tested
/// `RefreshToken`/`User` relationship is never touched. Only the SHA-256
/// hash of the token is stored, never the raw token, same as `RefreshToken`.
model ContactRefreshToken {
  id         String    @id @default(uuid())
  contactId  String    @map("contact_id")
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([contactId])
  @@map("contact_refresh_tokens")
  @@schema("customers")
}

/// Story 66 — see docs/architecture/03-domain-boundaries.md ("Customer
/// Management" owns "attachment metadata") and
/// docs/architecture/04-data-and-multitenancy.md ("Attachment binaries
/// live in S3-compatible object storage; Postgres stores key, filename,
/// size, MIME type, and owning entity metadata"). A direct `ticketId` FK,
/// not a polymorphic entity-type table — mirrors `TicketNote`/
/// `TicketCsatResponse`'s own plain-single-parent-FK shape, this
/// codebase's only existing precedent. Foundation only: ticket attachments
/// are the first real consumer; customer-level attachments are a
/// deferred, separately-planned follow-up. `key` is the S3 object key
/// (server-generated, never derived from the client-supplied filename).
/// Story 103 — `uploadedByUserId`/`uploadedByContactId` mirror
/// `ChannelMessage`'s own `senderUserId`/`senderContactId` shape exactly:
/// both nullable, exactly one populated per row (an agent-initiated
/// upload sets `uploadedByUserId`; a portal-contact-initiated one sets
/// `uploadedByContactId`) — enforced by which `AttachmentsService` method
/// is called, not a DB constraint, matching `ChannelMessagesService`'s
/// own precedent of no DB-level XOR check.
model TicketAttachment {
  id                  String   @id @default(uuid())
  ticketId            String   @map("ticket_id")
  ticket              Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  key                 String   @unique
  filename            String
  size                Int
  mimeType            String   @map("mime_type")
  uploadedByUserId    String?  @map("uploaded_by_user_id")
  uploadedByUser      User?    @relation(fields: [uploadedByUserId], references: [id])
  uploadedByContactId String?  @map("uploaded_by_contact_id")
  uploadedByContact   Contact? @relation(fields: [uploadedByContactId], references: [id])
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ticket_attachments")
  @@schema("customers")
}

/// Story 67 — the second named consumer `TicketAttachment`'s own doc
/// comment already anticipated ("customer-level attachments are a
/// deferred, separately-planned follow-up"). A separate model, not a
/// retrofit of `TicketAttachment` into a polymorphic entity-type table —
/// same reasoning: no existing precedent for polymorphic entity tables
/// anywhere in this schema. Identical shape to `TicketAttachment`.
model CustomerAttachment {
  id               String   @id @default(uuid())
  customerId       String   @map("customer_id")
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  key              String   @unique
  filename         String
  size             Int
  mimeType         String   @map("mime_type")
  uploadedByUserId String   @map("uploaded_by_user_id")
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_attachments")
  @@schema("customers")
}

// ---------------------------------------------------------------------------
// ticketing schema
// ---------------------------------------------------------------------------

/// See docs/architecture/03-domain-boundaries.md ("Ticketing"). Domain-event
/// emission (ticket.created/ticket.updated/ticket.escalated) and CASL-based
/// per-record visibility are named in the architecture but explicitly
/// deferred by Story 07 — see that story's "Settled decisions" section.
/// `category` is a plain nullable String, not a lookup table — no story has
/// justified a `Category` model yet.
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@schema("ticketing")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@schema("ticketing")
}

model Ticket {
  id                String               @id @default(uuid())
  branchId          String               @map("branch_id")
  branch            Branch               @relation(fields: [branchId], references: [id])
  departmentId      String?              @map("department_id")
  department        Department?          @relation(fields: [departmentId], references: [id])
  customerId        String               @map("customer_id")
  customer          Customer             @relation(fields: [customerId], references: [id])
  contactId         String?              @map("contact_id")
  contact           Contact?             @relation(fields: [contactId], references: [id])
  assignedToUserId  String?              @map("assigned_to_user_id")
  assignedToUser    User?                @relation(fields: [assignedToUserId], references: [id])
  subject           String
  category          String?
  priority          TicketPriority       @default(MEDIUM)
  status            TicketStatus         @default(OPEN)
  historyEntries    TicketHistoryEntry[]
  notes             TicketNote[]
  csatResponse      TicketCsatResponse?
  slaTarget         SlaTicketTarget?
  slaEscalations    SlaEscalation[]
  notificationLogs  NotificationLog[]
  attachments       TicketAttachment[]
  channelMessages   ChannelMessage[]
  aiPromptLogs      AiPromptLog[]
  /// Story 85 — bare Prisma back-relation for `ChatSession.escalatedTicketId`;
  /// carries no database column of its own (the FK/unique constraint lives
  /// entirely on `ChatSession`).
  chatSessionOrigin ChatSession?
  /// Story 99 — when this ticket most recently entered the RESOLVED/CLOSED
  /// tier (TicketsService's own RESOLVED_STATUSES, mirroring the existing
  /// submitCsat eligibility check). Null until first resolved; cleared back
  /// to null if reopened (moved back to OPEN/IN_PROGRESS); left unchanged
  /// by a RESOLVED<->CLOSED shuffle, since the ticket was never actually
  /// reopened. Historical tickets resolved before this column existed are
  /// never backfilled and stay null forever — see reporting.service.ts's
  /// getResolutionTime, the only consumer.
  resolvedAt        DateTime?            @map("resolved_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([branchId])
  @@index([customerId])
  @@index([assignedToUserId])
  @@map("tickets")
  @@schema("ticketing")
}

/// Append-only history entry for a Ticket's `ticket.created`/`ticket.updated`
/// domain events — see docs/architecture/03-domain-boundaries.md ("Ticketing",
/// "history/timeline"). No `branchId` — scoping is always derived from the
/// parent Ticket, the same way `customers.Contact` has no `branchId` of its
/// own. `snapshot` is the exact `TicketSummary` the emitting event carried —
/// no diff, no changed-fields computation.
model TicketHistoryEntry {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUserId String?  @map("actor_user_id")
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  eventType   String   @map("event_type")
  snapshot    Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ticket_history_entries")
  @@schema("ticketing")
}

/// Free-text, agent-only note on a Ticket — never customer-visible, never
/// sourced from an external channel (see docs/architecture/03-domain-boundaries.md,
/// "Communication / Channels" — that domain, not this model, owns
/// customer-facing messages/threads). Append-only: no update/delete route.
/// No `branchId` — scoping is always derived from the parent Ticket, the
/// same way `TicketHistoryEntry` has none. Unlike `TicketHistoryEntry`,
/// `authorUserId` is required, not nullable — a note can only ever result
/// from a deliberate, authenticated agent action, never a system event.
model TicketNote {
  id           String   @id @default(uuid())
  ticketId     String   @map("ticket_id")
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId String   @map("author_user_id")
  author       User     @relation(fields: [authorUserId], references: [id])
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ticket_notes")
  @@schema("ticketing")
}

/// Story 55 — one-time customer satisfaction rating on a Ticket, submitted
/// only via the Customer Portal once the ticket is RESOLVED or CLOSED — see
/// docs/architecture/08-supporting-domains.md ("CSAT/feedback"). Mirrors
/// `TicketNote` exactly except `submittedByContactId` is a Contact, never
/// an agent User — a CSAT response can only ever come from a portal
/// Contact. `@@unique([ticketId])`: exactly one response per ticket,
/// immutable once created (append-only, no update/delete route, same
/// convention as `TicketNote`).
model TicketCsatResponse {
  id                   String   @id @default(uuid())
  ticketId             String   @unique @map("ticket_id")
  ticket               Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  submittedByContactId String   @map("submitted_by_contact_id")
  submittedByContact   Contact  @relation(fields: [submittedByContactId], references: [id])
  rating               Int
  comment              String?
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("ticket_csat_responses")
  @@schema("ticketing")
}

// ---------------------------------------------------------------------------
// sla schema
// ---------------------------------------------------------------------------

/// See docs/architecture/03-domain-boundaries.md ("SLA & Automation") and
/// docs/architecture/07-sla-automation-and-ai.md ("SlaPolicy is scoped by
/// branch/department, category, and priority, and defines response/
/// resolution targets and a business-hours calendar"). This story implements
/// only the scoping dimensions and plain-minute targets — no business-hours
/// calendar, no target computation, no consumption by Ticketing events (see
/// Story 10's "Settled decisions"). `priority` is deliberately a plain
/// nullable String, not the `TicketPriority` enum (which lives in a
/// different Postgres schema) — mirrors `Ticket.category`'s own precedent.
/// No uniqueness constraint across the scoping dimensions — policy
/// resolution is a future story's concern, not this one's.
model SlaPolicy {
  id                      String            @id @default(uuid())
  branchId                String            @map("branch_id")
  branch                  Branch            @relation(fields: [branchId], references: [id])
  departmentId            String?           @map("department_id")
  department              Department?       @relation(fields: [departmentId], references: [id])
  category                String?
  priority                String?
  responseTargetMinutes   Int               @map("response_target_minutes")
  resolutionTargetMinutes Int               @map("resolution_target_minutes")
  isActive                Boolean           @default(true) @map("is_active")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  targets                 SlaTicketTarget[]

  @@index([branchId])
  @@map("sla_policies")
  @@schema("sla")
}

/// Story 57 — a simple trigger-condition-action automation rule
/// (docs/architecture/07-sla-automation-and-ai.md — "AutomationRule"). v1:
/// the trigger is implicitly `ticket.created` (not persisted — every rule
/// is one); the condition is a single optional `category` equality match
/// (`null` matches any category, mirroring `SlaPolicy.category`'s own
/// wildcard convention); the action is always "assign to a specific
/// agent" — deliberately excludes category/priority/department (those are
/// `SlaPolicy`'s own matching dimensions; an automation-driven change to
/// any of them would risk desyncing a ticket's SLA target with no existing
/// reconciliation mechanism, unlike a real agent's `ticket.recategorized`).
model AutomationRule {
  id                    String      @id @default(uuid())
  branchId              String      @map("branch_id")
  branch                Branch      @relation(fields: [branchId], references: [id])
  name                  String
  isActive              Boolean     @default(true) @map("is_active")
  conditionCategory     String?     @map("condition_category")
  actionAssignToUserId  String      @map("action_assign_to_user_id")
  actionAssignToUser    User        @relation(fields: [actionAssignToUserId], references: [id])
  /// Story 83 — both nullable/independent: a rule may set neither, one,
  /// or both, alongside its always-required assignment action. Applied
  /// only when the matched ticket's own current value is still `null`
  /// (never overrides an explicit human choice) — mirrors
  /// `AutomationActionListener`'s existing `assignedToUserId` guard.
  actionSetCategory     String?     @map("action_set_category")
  actionSetDepartmentId String?     @map("action_set_department_id")
  actionSetDepartment   Department? @relation(fields: [actionSetDepartmentId], references: [id])
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("automation_rules")
  @@schema("sla")
}

/// The first row of runtime SLA automation state (see
/// docs/architecture/07-sla-automation-and-ai.md, "SLA targets are computed
/// when a ticket is created... by `SlaModule` reacting to `ticket.created`")
/// — computed once, when a ticket is created, and never mutated (this story
/// does not react to `ticket.updated`, see Story 11's "Settled decisions").
/// Strict 1:1 with `Ticket` (`ticketId` is `@unique`), not an append-only
/// log, because no recomputation happens. `slaPolicyId` is kept only for
/// traceability. Absolute timestamps (`responseTargetAt`/`resolutionTargetAt`),
/// not raw minute counts, so a later edit to the matched `SlaPolicy` never
/// retroactively changes an already-computed target. No `branchId` — scope
/// is always derived through the parent `Ticket`, the same precedent
/// `TicketHistoryEntry` and `customers.Contact` already established.
/// `onDelete: Cascade` on `ticket` mirrors `TicketHistoryEntry.ticket`'s own
/// explicit choice exactly (schema.prisma, `TicketHistoryEntry` model).
/// Story 15 adds the four `*NotifiedAt` columns below — the one deliberate
/// exception to "never mutated": fire-once bookkeeping for the `sla-timers`
/// job (apps/worker/src/queues/sla-timer.processor.ts), set at most once
/// each via a conditional update. `responseTargetAt`/`resolutionTargetAt`/
/// `slaPolicyId` remain untouched by that job.
model SlaTicketTarget {
  id                           String    @id @default(uuid())
  ticketId                     String    @unique @map("ticket_id")
  ticket                       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  slaPolicyId                  String    @map("sla_policy_id")
  slaPolicy                    SlaPolicy @relation(fields: [slaPolicyId], references: [id])
  responseTargetAt             DateTime  @map("response_target_at")
  resolutionTargetAt           DateTime  @map("resolution_target_at")
  responseAtRiskNotifiedAt     DateTime? @map("response_at_risk_notified_at")
  responseBreachedNotifiedAt   DateTime? @map("response_breached_notified_at")
  resolutionAtRiskNotifiedAt   DateTime? @map("resolution_at_risk_notified_at")
  resolutionBreachedNotifiedAt DateTime? @map("resolution_breached_notified_at")
  createdAt                    DateTime  @default(now()) @map("created_at")

  @@map("sla_ticket_targets")
  @@schema("sla")
}

/// Story 17 — the persisted record of one escalated SLA breach transition.
/// Identity is (ticketId, targetType, targetAt), not slaTicketTargetId:
/// SlaTicketTarget.id stays constant across a Story 16 recategorization
/// recompute (only its target timestamps/slaPolicyId change), so targetAt is
/// what actually distinguishes "breach under the old target" from "breach
/// under the recomputed one" — the two must produce two separate rows here,
/// not one. Append-only: never updated after creation, mirroring
/// TicketHistoryEntry's own convention. Deliberately has no FK to
/// SlaTicketTarget/SlaPolicy — resolving one would require an extra lookup
/// that can race against SlaTargetListener.onTicketRecategorized deleting
/// that exact row when a recategorization no longer matches any policy.
model SlaEscalation {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  branchId    String   @map("branch_id")
  targetType  String   @map("target_type")
  targetAt    DateTime @map("target_at")
  escalatedAt DateTime @default(now()) @map("escalated_at")

  @@unique([ticketId, targetType, targetAt])
  @@map("sla_escalations")
  @@schema("sla")
}

/// Story 12 — the persistence/CRUD foundation for the business-hours
/// calendar named in docs/architecture/07-sla-automation-and-ai.md
/// ("SlaPolicy... defines... a business-hours calendar") and
/// docs/architecture/10-i18n-and-rtl.md ("Each branch stores an IANA
/// timezone for SLA business-hours calculations"). One calendar per Branch
/// (`branchId` is `@unique`) — `Branch.timezone` (identity schema) is the
/// timezone basis for interpreting `BusinessHoursDay`/`BusinessHoursException`
/// minute-of-day values; it is deliberately NOT duplicated onto this model.
/// This story does not consume the calendar — `SlaTargetListener` (Story 11)
/// is unchanged and keeps using plain wall-clock arithmetic.
model BusinessHoursCalendar {
  id         String                   @id @default(uuid())
  branchId   String                   @unique @map("branch_id")
  branch     Branch                   @relation(fields: [branchId], references: [id])
  days       BusinessHoursDay[]
  exceptions BusinessHoursException[]
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  @@map("business_hours_calendars")
  @@schema("sla")
}

/// Exactly one row per weekday (0=Sunday..6=Saturday, matching JS
/// `Date#getUTCDay()`/`Intl` conventions — see docs/architecture/10-i18n-and-rtl.md)
/// per calendar — always all 7, replaced wholesale on create/update, never
/// managed as an open-ended list (unlike `BusinessHoursException`). A single
/// open interval per day (`startMinute`/`endMinute`, minutes since midnight,
/// 0-1439) is all repository evidence supports — no multi-interval/split-shift
/// requirement is named anywhere, so a list-of-intervals table is deliberately
/// not introduced (see Story 12's "avoid speculative generic scheduling
/// abstractions"). Both null when `isOpen` is false (closed day). Overnight
/// intervals (`startMinute > endMinute`) are not supported in this
/// foundation — deferred, no evidence requires them yet.
model BusinessHoursDay {
  id          String                @id @default(uuid())
  calendarId  String                @map("calendar_id")
  calendar    BusinessHoursCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  weekday     Int
  isOpen      Boolean               @default(false) @map("is_open")
  startMinute Int?                  @map("start_minute")
  endMinute   Int?                  @map("end_minute")

  @@unique([calendarId, weekday])
  @@map("business_hours_days")
  @@schema("sla")
}

/// A calendar-specific closure or overridden-hours exception for one date.
/// Open-ended list (unlike `BusinessHoursDay`), so it is managed the same
/// way `customers.Contact` is managed under `Customer` — created/listed/
/// updated individually, never replaced wholesale. `date` uses `@db.Date`
/// (no time component — this is a calendar date, not a timestamp; the
/// first `@db.*` mapping in this schema, chosen because nothing else here
/// is a pure date-only value). `isClosed: true` means fully closed that
/// date (override fields null); `isClosed: false` means the normal
/// `BusinessHoursDay` for that weekday is replaced by
/// `overrideStartMinute`/`overrideEndMinute` for this date only. No
/// `branchId` — scope is derived through the parent `BusinessHoursCalendar`
/// (→ `Branch`), the same precedent `Contact`/`TicketHistoryEntry`/
/// `SlaTicketTarget` already established.
model BusinessHoursException {
  id                  String                @id @default(uuid())
  calendarId          String                @map("calendar_id")
  calendar            BusinessHoursCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date                DateTime              @db.Date
  isClosed            Boolean               @default(true) @map("is_closed")
  overrideStartMinute Int?                  @map("override_start_minute")
  overrideEndMinute   Int?                  @map("override_end_minute")
  createdAt           DateTime              @default(now()) @map("created_at")

  @@unique([calendarId, date])
  @@map("business_hours_exceptions")
  @@schema("sla")
}

// ---------------------------------------------------------------------------
// notifications schema
// ---------------------------------------------------------------------------

/// Story 18 — the Notifications domain's first table (see
/// docs/architecture/03-domain-boundaries.md, "Notifications... Templates,
/// delivery logs, per-user preferences... owns notification routing").
/// Deliberately narrow: this story records only that an `sla.at_risk`
/// transition occurred, not an actual delivered notification — recipient
/// resolution, template rendering, and channel delivery (the full
/// `NotificationService` design in
/// docs/architecture/06-communication-and-realtime.md) are a future story's
/// concern. `eventType` is a plain String (not an enum) so a later event
/// type can populate this same table without a migration, mirroring
/// `TicketHistoryEntry.eventType`'s own precedent — only `"sla.at_risk"` is
/// ever written by this story. Identity for idempotency is
/// (eventType, ticketId, targetType, targetAt), not `slaTicketTargetId`:
/// `SlaTicketTarget.id` stays constant across a Story 16 recategorization
/// recompute, so `targetAt` is what actually distinguishes one at-risk
/// transition from the next (the same reasoning `SlaEscalation`, Story 17,
/// already established). No FK to `SlaTicketTarget`/`SlaPolicy` — resolving
/// one would require an extra lookup that can race against
/// `SlaTargetListener.onTicketRecategorized` deleting that exact row.
/// Append-only: never updated after creation.
///
/// Story 19 — `branchId`/`targetType`/`targetAt` widened to nullable and
/// `dedupeKey` added to support `ticket.escalated`, whose payload
/// (`TicketEscalatedEvent`) carries none of the three SLA-shaped fields.
/// Reusing the existing `(eventType, ticketId, targetType, targetAt)`
/// constraint for those rows would enforce nothing — Postgres never treats
/// two `NULL`s as equal — so `dedupeKey` is a second, independent identity:
/// left `null` on every SLA row (never written by
/// `SlaAtRiskNotificationListener`, unmodified), set to the ticket id on
/// every `ticket.escalated` row. The two `@@unique` constraints below are
/// deliberately separate and never interact.
model NotificationLog {
  id         String    @id @default(uuid())
  eventType  String    @map("event_type")
  ticketId   String    @map("ticket_id")
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  branchId   String?   @map("branch_id")
  targetType String?   @map("target_type")
  targetAt   DateTime? @map("target_at")
  dedupeKey  String?   @map("dedupe_key")
  loggedAt   DateTime  @default(now()) @map("logged_at")

  /// Story 88 — set only by `PortalNotificationLogListener`, for a
  /// customer-scoped (portal) notification row; every pre-existing writer
  /// (`SlaAtRiskNotificationListener`/`TicketEscalatedNotificationListener`)
  /// leaves this `null`. Lets the agent-facing `NotificationsService.
  /// listNotifications()` exclude these rows with a plain `customerId: null`
  /// filter, and lets the portal's `listNotificationsForCustomer` filter
  /// directly without a `ticket` relation join.
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([eventType, ticketId, targetType, targetAt])
  @@unique([eventType, dedupeKey])
  @@map("notification_logs")
  @@schema("notifications")
}

/// Story 58 — a per-user, per-event-type toggle for the three live,
/// branch-wide in-app notification events (`sla.at_risk`/`sla.breached`/
/// `ticket.escalated` — the same set `BranchNotificationRealtimeListener`
/// relays). Self-scoped (owned by the requesting user, resolved from the
/// JWT, never an admin resource) — no row means "enabled" (the default),
/// mirroring `SlaPolicy`'s own "absence means unrestricted" convention.
/// Governs only the live in-app toast, never `NotificationLog`/history
/// (Design decision 1).
model NotificationPreference {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType    String   @map("event_type")
  inAppEnabled Boolean  @default(true) @map("in_app_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, eventType])
  @@map("notification_preferences")
  @@schema("notifications")
}

/// Story 90 — the Customer Portal's counterpart to `NotificationPreference`,
/// for a `Contact` rather than a `User`. A brand-new, separate table —
/// mirrors this codebase's own `ContactRefreshToken`-vs-`RefreshToken`
/// precedent (a separate table so the `customers` schema keeps owning
/// everything about a Contact's lifecycle, and so the already-shipped
/// `NotificationPreference`/`User` relationship is never touched) —
/// rather than widening `NotificationPreference` with a nullable
/// `contactId`. Governs only the live in-app toast for the two events
/// `CustomerNotificationRealtimeListener` relays (`ticket.updated`/
/// `channel.message.created`), never `NotificationLog`/history. No row
/// means "enabled" — identical convention to `NotificationPreference`.
model PortalNotificationPreference {
  id           String   @id @default(uuid())
  contactId    String   @map("contact_id")
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  eventType    String   @map("event_type")
  inAppEnabled Boolean  @default(true) @map("in_app_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([contactId, eventType])
  @@map("portal_notification_preferences")
  @@schema("notifications")
}

/// Story 61 — a branch admin's custom message for one notification event
/// type. Plain text with `{ticketId}`/`{targetType}` placeholders,
/// substituted at render time (never rendered through `next-intl`/ICU) —
/// consumed only by the Notification History table for now (Design
/// decision 3); the live in-app toast is untouched. `@@unique([branchId,
/// eventType])`: exactly one template per event type per branch, upserted.
model NotificationTemplate {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id])
  eventType String   @map("event_type")
  template  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([branchId, eventType])
  @@map("notification_templates")
  @@schema("notifications")
}

// ---------------------------------------------------------------------------
// knowledge_base schema
// ---------------------------------------------------------------------------

enum KnowledgeBaseArticleStatus {
  DRAFT
  PUBLISHED

  @@schema("knowledge_base")
}

/// Story 51 — see docs/architecture/03-domain-boundaries.md ("Knowledge
/// Base") and docs/architecture/08-supporting-domains.md. Foundation only:
/// a branch-scoped aggregate root (mirroring `SlaPolicy`'s exact shape) with
/// a draft/published toggle. `publishedAt` remains a plain last-transition
/// timestamp on the live row, overwritten on every re-publish — the actual
/// version history lives in `KnowledgeBaseArticleVersion` (Story 65). No
/// Customer Portal or AI Services consumption yet.
model KnowledgeBaseArticle {
  id           String                        @id @default(uuid())
  branchId     String                        @map("branch_id")
  branch       Branch                        @relation(fields: [branchId], references: [id])
  title        String
  body         String
  category     String?
  status       KnowledgeBaseArticleStatus    @default(DRAFT)
  publishedAt  DateTime?                     @map("published_at")
  createdAt    DateTime                      @default(now()) @map("created_at")
  updatedAt    DateTime                      @updatedAt @map("updated_at")
  /// Story 102 — generated column (see this story's own migration SQL):
  /// `to_tsvector('english', title || ' ' || body)`, STORED, with a GIN
  /// index. `Unsupported` because Prisma Client has no native `tsvector`
  /// type — matched via `$queryRaw` in `KnowledgeBaseService`'s
  /// `searchArticles` helper, never read or written through the client's
  /// typed `create`/`update`/`findMany` API (Postgres maintains it
  /// itself; `Unsupported` fields are automatically excluded from every
  /// generated input type, so no existing call site needs to change).
  searchVector Unsupported("tsvector")?      @map("search_vector")
  versions     KnowledgeBaseArticleVersion[]

  @@index([branchId])
  @@map("knowledge_base_articles")
  @@schema("knowledge_base")
}

/// Story 65 — see docs/architecture/08-supporting-domains.md ("publishing
/// creates a new version rather than mutating published content").
/// Immutable, append-only: a row is created only when `updateArticle`
/// transitions `status` to `PUBLISHED` (see `KnowledgeBaseService`'s own
/// doc comment for the exact site), never on a plain content edit or an
/// unpublish. `versionNumber` is 1-based and per-article sequential,
/// derived from the existing rows at write time rather than a redundant
/// counter column. `publishedAt` here is this version's own publish
/// timestamp — distinct from the live article's own, separately-mutable
/// `publishedAt`.
model KnowledgeBaseArticleVersion {
  id            String               @id @default(uuid())
  articleId     String               @map("article_id")
  article       KnowledgeBaseArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  versionNumber Int                  @map("version_number")
  title         String
  body          String
  category      String?
  publishedAt   DateTime             @map("published_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@unique([articleId, versionNumber])
  @@index([articleId])
  @@map("knowledge_base_article_versions")
  @@schema("knowledge_base")
}

// ---------------------------------------------------------------------------
// ai schema
// ---------------------------------------------------------------------------

/// Story 72 — the four capabilities `AiProvider` exposes, per
/// docs/architecture/07-sla-automation-and-ai.md. `CHAT` covers every
/// chatbot-session turn — a future story may split this further, not this
/// foundation slice.
enum AiFeature {
  SUMMARIZE
  SUGGEST_REPLY
  CATEGORIZE
  CHAT

  @@schema("ai")
}

/// Story 72 — `DISABLED` is a first-class, expected outcome (no
/// `ANTHROPIC_API_KEY` configured), never conflated with `ERROR` (a real
/// provider failure) — a caller or operator reading this log must be able
/// to tell "AI is off" from "AI is broken" at a glance.
///
/// Story 76 — `PENDING` added: the row's state from the moment `apps/api`
/// creates it (before enqueueing `ai-processing`) until `apps/worker`
/// resolves it to one of the other three outcomes. Never set again once
/// left — this is a one-way transition, not a status that toggles back.
enum AiOutcome {
  PENDING
  SUCCESS
  ERROR
  DISABLED

  @@schema("ai")
}

/// Story 72 — AI Services Foundation. See
/// docs/architecture/03-domain-boundaries.md ("AI Services") and
/// docs/architecture/07-sla-automation-and-ai.md ("Every call logs prompt
/// reference, model, token usage, latency, and outcome"). Mirrors
/// `NotificationLog`'s own flat shape.
///
/// Story 76 — no longer strictly append-only: `apps/api`'s
/// `AiGatewayService.createPendingLog` creates the row (`outcome:
/// PENDING`, `model: "pending"`, `latencyMs: null`) *before* the AI
/// provider is ever called (docs/architecture/02-system-architecture-
/// overview.md: "apps/api never blocks a request on slow external
/// work... calling the AI provider... always enqueued to BullMQ"); this
/// is the one durable handle returned to the HTTP caller. `apps/worker`'s
/// `AiProcessingProcessor` performs exactly one `update` on that same row
/// once the call resolves — never a second row for the same operation.
model AiPromptLog {
  id            String       @id @default(uuid())
  branchId      String       @map("branch_id")
  branch        Branch       @relation(fields: [branchId], references: [id])
  /// Story 79 — nullable: rows created by Stories 72-76 before this
  /// column existed have none. Every row created after this story ships
  /// always sets it (AiGatewayService.createPendingLog, Task 2).
  ticketId      String?      @map("ticket_id")
  ticket        Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  /// Story 80 — nullable, mutually exclusive with `ticketId` by
  /// `feature`: set only for `CHAT` operations (AiChatService.sendMessage),
  /// never alongside a `ticketId`.
  chatSessionId String?      @map("chat_session_id")
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  feature       AiFeature
  model         String
  promptRef     String       @map("prompt_ref")
  inputTokens   Int?         @map("input_tokens")
  outputTokens  Int?         @map("output_tokens")
  /// Story 76 — nullable: unknown until `apps/worker` finishes the call;
  /// `null` exactly when `outcome` is still `PENDING`.
  latencyMs     Int?         @map("latency_ms")
  outcome       AiOutcome
  /// Story 79 — the actual generated text (summary / suggested reply /
  /// suggested category). Null exactly when outcome is PENDING, ERROR,
  /// or DISABLED (see packages/ai's AiCallResult.text: string | null).
  /// Named outputText, not `output`, to stay unambiguous next to the
  /// existing outputTokens field.
  outputText    String?      @map("output_text")
  errorMessage  String?      @map("error_message")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([branchId])
  @@index([feature])
  @@index([ticketId])
  @@index([chatSessionId])
  @@map("ai_prompt_logs")
  @@schema("ai")
}

enum ChatMessageRole {
  CUSTOMER
  ASSISTANT

  @@schema("ai")
}

/// Story 81 — one row per branch, mirrors `BrandingConfig`'s exact
/// shape/conventions. Absence of a row means every feature is enabled
/// (the pre-Story-81 behavior, unchanged) — see AiSettingsService's own
/// DEFAULT_AI_SETTINGS.
model AiSettings {
  id                  String   @id @default(uuid())
  branchId            String   @unique @map("branch_id")
  branch              Branch   @relation(fields: [branchId], references: [id])
  summarizeEnabled    Boolean  @default(true) @map("summarize_enabled")
  suggestReplyEnabled Boolean  @default(true) @map("suggest_reply_enabled")
  categorizeEnabled   Boolean  @default(true) @map("categorize_enabled")
  chatEnabled         Boolean  @default(true) @map("chat_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
  @@schema("ai")
}

/// Story 80 — one portal self-service chat conversation. No
/// `TicketVisibilityScope`/department scoping: a chat session belongs to
/// exactly one Contact, checked directly (mirrors `ContactRefreshToken`'s
/// own contact-scoping, not `Ticket`'s department-visibility mechanism).
model ChatSession {
  id           String        @id @default(uuid())
  branchId     String        @map("branch_id")
  branch       Branch        @relation(fields: [branchId], references: [id])
  contactId    String        @map("contact_id")
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  aiPromptLogs AiPromptLog[]
  createdAt    DateTime      @default(now()) @map("created_at")

  /// Story 85 — set once this session has been escalated into a real
  /// support ticket (`PortalTicketsService.escalateChatSession`). Mirrors
  /// `AiPromptLog.ticketId`'s own cross-schema-FK precedent (the `ai`
  /// schema already references `ticketing` there) rather than putting a
  /// pointer on `Ticket` itself — a chat session is the thing that
  /// "resolves into" a ticket, not the other way around. `@unique`
  /// guarantees at most one session ever escalates into any given ticket.
  escalatedTicketId String? @unique @map("escalated_ticket_id")
  escalatedTicket   Ticket? @relation(fields: [escalatedTicketId], references: [id])

  @@index([branchId])
  @@index([contactId])
  @@map("chat_sessions")
  @@schema("ai")
}

/// Story 80 — one turn in a `ChatSession`. Only `ASSISTANT` messages with
/// a real reply are ever inserted here (a failed/disabled turn is never
/// persisted as a message — see `AiProcessingProcessor`'s own comment);
/// `outcome`/`errorMessage` for that turn live on the `AiPromptLog` row
/// instead, retrieved via `GET .../ai/:logId` exactly like ticket AI.
model ChatMessage {
  id        String          @id @default(uuid())
  sessionId String          @map("session_id")
  session   ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatMessageRole
  body      String
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
  @@schema("ai")
}

// ---------------------------------------------------------------------------
// channels schema
// ---------------------------------------------------------------------------

/// Story 77 — the five channel types docs/architecture/06-communication-
/// and-realtime.md names as a fixed taxonomy ("email, WhatsApp, SMS, live
/// chat, and web-form messages"). Only `LIVE_CHAT` has any producer in
/// this story — the other four are documented scope, not speculative
/// values, mirroring `AiFeature`'s own precedent (Story 72 declared all
/// four AI methods even though only three had a producer until Story 76).
enum ChannelType {
  EMAIL
  WHATSAPP
  SMS
  LIVE_CHAT
  WEB_FORM
  /// Story 85 — a replayed AI chatbot transcript attached to a ticket
  /// created via chat escalation. Distinct from `LIVE_CHAT`: the
  /// conversation did not happen on the ticket's own live-chat channel.
  AI_CHAT

  @@schema("channels")
}

/// Story 77 — mirrors 09-integrations.md's own inbound/outbound framing
/// ("Inbound provider webhooks..."/"Outbound email, SMS, WhatsApp... work").
enum ChannelMessageDirection {
  INBOUND
  OUTBOUND

  @@schema("channels")
}

/// Story 77 — Customer Portal Live Chat, the first real `ChannelMessage`
/// consumer (docs/architecture/06-*: "Live chat is a first-class Socket.IO
/// flow between portal/widget and `apps/api`, normalized to
/// `ChannelMessage`" — decided to mean the authenticated Customer Portal,
/// not an anonymous public widget; see this story's own plan). One row
/// per message, either direction. `externalThreadId` stays nullable and
/// unused by `LIVE_CHAT` (a first-party socket flow, not an external
/// provider thread) — it exists for the other four channel types' future
/// stories, not invented use here. Exactly one of `senderContactId`/
/// `senderUserId` is set, matching `direction` (`INBOUND` → contact,
/// `OUTBOUND` → user) — an application-layer invariant
/// (`ChannelMessagesService`), the same "app-layer invariant over a DB
/// constraint" convention `Contact.email`'s own doc comment already
/// established, since Prisma has no portable partial/conditional
/// constraint for "exactly one of two nullable columns." No `attachments`
/// field yet — out of scope for this story (see the plan's Non-goals).
model ChannelMessage {
  id               String                  @id @default(uuid())
  ticketId         String                  @map("ticket_id")
  ticket           Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  channelType      ChannelType             @map("channel_type")
  direction        ChannelMessageDirection
  externalThreadId String?                 @map("external_thread_id")
  senderContactId  String?                 @map("sender_contact_id")
  senderContact    Contact?                @relation(fields: [senderContactId], references: [id])
  senderUserId     String?                 @map("sender_user_id")
  senderUser       User?                   @relation(fields: [senderUserId], references: [id])
  body             String
  createdAt        DateTime                @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("channel_messages")
  @@schema("channels")
}

/// Story 91 — the Communication/Channels domain's last remaining,
/// non-provider-blocked named noun (docs/architecture/03-domain-
/// boundaries.md: "channel configuration, inbound/outbound messages,
/// threads, quick replies"). A branch-admin-authored, reusable canned
/// response an agent can insert into a ticket's chat composer
/// (`ChatComposer`, Story 78) verbatim — no variable interpolation, no
/// department scoping, mirrors `AutomationRule`'s exact "no unique
/// constraint on the human-facing name, `isActive` soft-toggle only"
/// shape.
model QuickReply {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id])
  title     String
  body      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("quick_replies")
  @@schema("channels")
}
