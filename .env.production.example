# Deployment configuration template — every value a deployed environment
# must supply. Copy to `.env.production` (gitignored) and fill it in, or
# transcribe these keys into whatever secret store the deployment platform
# uses (Kubernetes Secrets, ECS task definition, a PaaS variable editor).
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml build
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# NOTHING BELOW IS A REAL VALUE. Every placeholder must be replaced. This
# repository intentionally contains no production hostnames, no production
# credentials and no real secrets — see docs/deployment.md for what each
# value means and how to verify it once set.
#
# The single most important distinction in this file:
#
#   BUILD-TIME values are compiled into an image and cannot be changed by
#   restarting a container. Changing one requires rebuilding the image.
#   RUNTIME values are read by the process at startup and take effect on
#   restart.

# ============================================================================
# BUILD-TIME — apps/web and apps/portal (compiled into the browser bundle)
# ============================================================================

# The public base URL of the deployed API, as a *browser* must call it,
# including the `/api/v1` suffix (apps/api mounts every route under that
# global prefix). This is substituted into the JavaScript that ships to the
# browser by `next build`; a runtime environment variable cannot change it.
#
# Must be an address reachable from the end user's browser — not an internal
# service name like `http://api:3001/api/v1`, which only resolves inside the
# container network. Next.js server components in the same image resolve the
# identical compiled-in constant, so the public address has to be reachable
# from the container too.
#
# Both frontends use the same value; the portal's routes live under
# `/portal/*` beneath it.
NEXT_PUBLIC_API_URL="https://api.example.com/api/v1"

# Optional (Story 113). Same DSN as SENTRY_DSN below; the `NEXT_PUBLIC_`
# copy is what the browser bundle can see.
NEXT_PUBLIC_SENTRY_DSN=""

# ============================================================================
# RUNTIME — database
# ============================================================================

# The migration/owner role. `prisma migrate deploy` and `prisma db seed` act
# on exactly this URL (the Prisma CLI reads schema.prisma's own
# `env("DATABASE_URL")` datasource), so it must be a role permitted to alter
# the schema.
DATABASE_URL="postgresql://OWNER_USER:OWNER_PASSWORD@DB_HOST:5432/crm?schema=public"

# Optional: the restricted runtime role (`crm_app`) the running API and
# worker connect as — provisioned by the `add_runtime_db_role_grants`
# migration, which denies it schema changes and denies UPDATE/DELETE on
# `admin.audit_logs`. Leave EMPTY to run as DATABASE_URL instead.
#
# THE TRAP: this must name the SAME DATABASE as DATABASE_URL. Point them at
# two different databases and everything looks healthy — migrations succeed,
# the API boots, both health checks pass — while every query runs against a
# database that was never migrated. The API logs a warning at boot when the
# two disagree; a differing host/port alone is fine (a connection pooler is
# a normal deployment).
#
# Rotate the password provisioned by the migration before going live:
#   ALTER ROLE crm_app WITH PASSWORD '<a real secret>';
APP_DATABASE_URL=""

# ============================================================================
# RUNTIME — Redis (BullMQ queues + the Socket.IO adapter)
# ============================================================================
REDIS_URL="redis://REDIS_HOST:6379"

# ============================================================================
# RUNTIME — authentication secrets
# ============================================================================

# Two INDEPENDENT secrets, each at least 32 characters. Generate them
# separately:
#   openssl rand -base64 48
#   openssl rand -base64 48
#
# The API refuses to start if these are equal: both are HMAC keys for the
# same algorithm, so one shared value makes a refresh token a structurally
# valid access token, defeating the short access-token lifetime and the
# server-side refresh-token revocation.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# ============================================================================
# RUNTIME — browser access (CORS + cookies)
# ============================================================================

# Comma-separated list of EVERY deployed browser origin that calls the API:
# the agent workspace and, where deployed, the customer portal. Required in
# production — the API refuses to start without it, because a production API
# with no allowed origins boots healthily while rejecting every browser
# request, which reads to a user as "login is broken".
#
# Each entry is scheme://host[:port] exactly as a browser sends it in the
# `Origin` header — no trailing slash, no path. (The API normalizes a
# trailing slash away and rejects anything carrying a path, rather than
# keeping a value that could never match.)
CORS_ORIGINS="https://crm.example.com,https://portal.example.com"

# `SameSite` for the httpOnly refresh-token cookie. This is decided by
# deployment topology, not by preference:
#
#   strict (default) — correct when the browser origins and the API share one
#                      registrable domain, e.g. crm.example.com calling
#                      api.example.com.
#   none             — REQUIRED when they do not. A SameSite=strict cookie is
#                      never sent cross-site, so `POST /auth/refresh` 401s and
#                      the session dies at the first access-token expiry —
#                      login appears to work and then silently breaks ~15
#                      minutes later, with nothing in the API logs.
#
# `none` is only accepted with NODE_ENV=production, since browsers reject a
# SameSite=None cookie that is not also Secure.
AUTH_COOKIE_SAMESITE="strict"

# ============================================================================
# RUNTIME — object storage (ticket/customer attachments)
# ============================================================================
S3_ENDPOINT="https://s3.example.com"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="crm-attachments"

# ============================================================================
# RUNTIME — optional
# ============================================================================

# Story 113 — Sentry or a self-hosted GlitchTip (protocol-compatible).
# Unset means unhandled exceptions are still caught and logged, just not
# reported externally.
SENTRY_DSN=""

# Enables the real Anthropic provider in apps/worker. Unset means AI
# features fall back to a no-op "disabled" provider that still logs the
# request but never calls out.
ANTHROPIC_API_KEY=""

# ============================================================================
# Published host ports (docker-compose.prod.yml only)
# ============================================================================
API_PORT=3001
WEB_PORT=3000
PORTAL_PORT=3002

# Image names/tags, when pulling pre-built images instead of building here.
# API_IMAGE="registry.example.com/crm-api:1.0.0"
# WORKER_IMAGE="registry.example.com/crm-worker:1.0.0"
# WEB_IMAGE="registry.example.com/crm-web:1.0.0"
# PORTAL_IMAGE="registry.example.com/crm-portal:1.0.0"

# ============================================================================
# NOT part of the running deployment — first-time bootstrap only
# ============================================================================
#
# Read ONLY by `apps/api/prisma/seed.ts`, never by the running app. The seed
# creates the first Organization/Branch/Department, the permission catalog,
# the baseline roles, and one bootstrap admin — it is what makes the very
# first login possible on an empty database.
#
# It is idempotent and safe to re-run, but it also RECONCILES role
# permission grants to the catalog in the code, so re-running it against a
# live production database resets any hand-edited grants on the seeded
# roles. Run it deliberately, once, on a new environment — not as part of
# every deploy. `docker-compose.prod.yml` therefore has no seed service; see
# docs/deployment.md for the explicit one-off command.
#
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD=""
